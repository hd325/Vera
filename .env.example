# Copy to .env and fill credentials locally. Never commit .env.
# Existing environment variables take precedence over this file.

VERA_HOST=127.0.0.1
VERA_PORT=8000
VERA_RELOAD=false
VERA_DATA_DIR=data
# The equivalent HOUKONG_* variables remain supported. VERA_* takes precedence.
# Leave blank to use an isolated store. Windows paths containing non-ASCII
# characters use LOCALAPPDATA/VeraPublic/<data-directory-id>/chroma_db.
VERA_CHROMA_DIR=

# Huawei MaaS is the main chat/file/planning provider. Fill this locally.
MAAS_API_KEY=
MAAS_API_URL=https://api.modelarts-maas.com/v2/chat/completions

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-flash

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
SERPER_API_KEY=
HUAWEI_AK=
HUAWEI_SK=
HUAWEI_PROJECT_ID=
HUAWEI_OCR_REGION=cn-north-4

# Optional CAPTCHA. All four values are required to enable the provider.
CAPTCHA_APP_KEY=
CAPTCHA_APP_SECRET=
CAPTCHA_APP_ID=
CAPTCHA_APP_ID_SECRET=

# Install requirements-file-agent.txt before enabling optional file editing.
ENABLE_FILE_AGENT=false

# Optional local OpenClaw/WeChat integration. Use your own isolated profile.
ENABLE_WECHAT=false
HOUKONG_WECHAT_SERVICE_TOKEN=
HOUKONG_WECHAT_BROKER_URL=http://127.0.0.1:18790
HOUKONG_WECHAT_ENV_FILE=

# tfidf runs offline. local needs requirements-local.txt and a downloaded model.
# auto tries Tencent (when configured), local, then tfidf.
EMBEDDING_BACKEND=tfidf
LOCAL_EMBEDDING_MODEL=shibing624/text2vec-base-chinese
